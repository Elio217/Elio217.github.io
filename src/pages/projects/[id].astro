---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { PROJECTS } from '../../data/portfolio';
export function getStaticPaths() { return PROJECTS.map((project) => ({ params: { id: project.id }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={project.title} description={project.description} sky>
  <div class="container page-content narrow-container"><a href="/projects/" class="back-link"><Icon name="back" size={17} />모든 프로젝트</a><header class="page-heading"><p class="eyebrow">{project.organization ?? 'PROJECT'}{project.status && ` · ${project.status}`}</p><h1>{project.title}<span class="accent">.</span></h1><p>{project.description}</p></header><div class="project-detail-panel"><div class="post-tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div><article class="prose">{project.notes.map(({ title, text }) => <section><h2>{title}</h2><p>{text}</p></section>)}</article>{project.repository && <a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer"><Icon name="github" size={17} />소스 코드 보기 <Icon name="external" size={15} /></a>}</div></div>
</BaseLayout>
<style>.project-detail-panel { padding: 28px; border: 1px solid var(--line-strong); border-radius: 12px; background: var(--glass); backdrop-filter: blur(14px); } .project-detail-panel .prose h2 { margin-top: 30px; } .project-detail-panel > .text-link { margin-top: 20px; color: var(--accent); } @media (max-width: 600px) { .project-detail-panel { padding: 23px; } }</style>
