---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import Icon from '../components/Icon.astro';
import ProfileImage from '../components/ProfileImage.astro';
import { CTF_RESULTS } from '../data/portfolio';
import { PROFILE, SITE } from '../site';

const formatCtfDate = (date: string) => date.replaceAll('-', '.');
---
<BaseLayout title="소개" description="Elio의 소개, 소속과 외부활동을 정리한 이력입니다." sky>
  <div class="container page-content career-page">
    <section class="career-intro" aria-labelledby="career-intro-title">
      <div class="career-avatar">
        {PROFILE.avatar ? <ProfileImage size={96} /> : <span aria-hidden="true">{[...PROFILE.name][0]?.toUpperCase()}</span>}
      </div>
      <div>
        <p class="eyebrow">{PROFILE.handle}</p>
        <h1 id="career-intro-title">{PROFILE.realName}</h1>
        <p>보안 초보자, 클라우드 보안을 주로 배우고 있습니다.</p>
        <a href={SITE.github} class="text-link" target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={16} />GitHub에서 만나기 <Icon name="external" size={14} />
        </a>
      </div>
    </section>
    <section class="career-section" aria-labelledby="career-title">
      <div class="career-section-heading">
        <Icon name="star" size={23} />
        <div>
          <p class="eyebrow">EDUCATION & ACTIVITIES</p>
          <h2 id="career-title">소속과 외부활동</h2>
        </div>
      </div>
      <CareerTimeline />
      <section class="ctf-section" aria-labelledby="ctf-title">
        <h3 id="ctf-title">CTF</h3>
        <ul class="ctf-results">
          {CTF_RESULTS.map(({ name, placement, startDate, endDate }) => (
            <li class="ctf-result">
              <p class="ctf-result-title">{name} - <span>{placement}</span></p>
              <p class="ctf-period">
                <time datetime={startDate}>{formatCtfDate(startDate)}</time>
                {endDate && <> ~ <time datetime={endDate}>{formatCtfDate(endDate)}</time></>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    </section>
  </div>
</BaseLayout>
<style>
  .career-page { max-width: 900px; }
  .career-intro { display: flex; gap: 28px; align-items: center; padding: 28px; border: 1px solid var(--line-strong); border-radius: 12px; background: var(--glass); backdrop-filter: blur(14px); }
  .career-avatar { flex-shrink: 0; width: 96px; height: 96px; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 50%; background: var(--accent-bg); color: var(--accent); font-size: 38px; }
  .career-avatar :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
  .career-intro h1 { font-size: 22px; margin-top: 9px; letter-spacing: -.8px; font-weight: 600; }
  .career-intro div > p:not(.eyebrow) { margin-top: 13px; color: var(--muted); font-size: 13px; line-height: 1.9; }
  .career-intro .text-link { margin-top: 12px; color: var(--accent); }
  .career-section { margin-top: 45px; padding: 30px; border: 1px solid var(--line-strong); border-radius: 12px; background: var(--glass); backdrop-filter: blur(14px); }
  .career-section-heading { display: flex; align-items: center; gap: 13px; }
  .career-section-heading > svg { color: var(--accent); }
  .career-section h2 { font-size: 23px; font-weight: 600; margin-top: 5px; letter-spacing: -.7px; }
  .ctf-section { margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--line-strong); }
  .ctf-section h3 { font-size: 18px; font-weight: 600; letter-spacing: .04em; }
  .ctf-results { list-style: none; margin: 18px 0 0; padding: 0; }
  .ctf-result { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 6px 20px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .ctf-result:first-child { padding-top: 0; }
  .ctf-result:last-child { padding-bottom: 0; border-bottom: 0; }
  .ctf-result-title { min-width: 0; font-size: 14px; font-weight: 500; line-height: 1.8; }
  .ctf-result-title span { color: var(--accent); white-space: nowrap; }
  .ctf-period { color: var(--muted); font-size: 12px; white-space: nowrap; }
  @media (max-width: 720px) { .ctf-result { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 600px) { .career-intro { flex-direction: column; align-items: flex-start; padding: 24px; } .career-intro h1 { font-size: 20px; } .career-section { padding: 25px 22px; } }
</style>
