---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import '@fontsource-variable/noto-sans-kr';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import milkyWay from '../assets/milky-way.png';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  article?: boolean;
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}
const { title, description = SITE.description, home = false, article = false, published, updated, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = await getImage({ src: milkyWay, width: 1200, format: 'jpg', quality: 80 });
const socialImage = new URL(shareImage.src, Astro.site);
---
<!doctype html>
<html lang="ko" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1018" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="은하수를 따라 배움을 기록하는 Elio의 개발 블로그" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('elio-theme');
        const theme = savedTheme === 'light' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#0b1018' : '#f4f5f9');
      } catch { /* 기본 밤하늘 테마를 사용합니다. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <Header overlay={home} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
