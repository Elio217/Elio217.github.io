---
import Icon from './Icon.astro';
import ProfileImage from './ProfileImage.astro';
import { PROFILE } from '../site';
const initial = [...PROFILE.name.trim()][0]?.toUpperCase() ?? 'E';
const details = PROFILE.details ?? [];
---
<aside class="profile-card" aria-labelledby="profile-name">
  <div class="profile-content">
    <div class="profile-avatar">
      {PROFILE.avatar ? <ProfileImage size={92} sizes="(max-width: 720px) 64px, 92px" /> : <span class="profile-initial" aria-hidden="true">{initial}</span>}
      <span class="profile-star"><Icon name="star" size={25} /></span>
    </div>
    <div class="profile-identity"><div class="profile-names"><h2 id="profile-name">{PROFILE.name}</h2>{PROFILE.realName && <span class="profile-real-name">{PROFILE.realName}</span>}</div>{PROFILE.handle && <p class="profile-handle">{PROFILE.handle}</p>}</div>
    {PROFILE.bio && <p class="profile-bio">{PROFILE.bio}</p>}
    {details.length > 0 && <dl class="profile-details">{details.map(({ label, value }) => <><dt>{label}</dt><dd>{value}</dd></>)}</dl>}
    {PROFILE.links.length > 0 && <nav class="profile-links" aria-label="프로필 링크">{PROFILE.links.map(({ label, href, icon }) => {
      const external = /^https?:\/\//.test(href);
      return <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}><Icon name={icon} size={18} /><span>{label}</span>{external && <Icon name="external" size={12} />}</a>;
    })}</nav>}
  </div>
</aside>
<style>
  .profile-card { min-width: 0; border-right: 1px solid var(--line-strong); padding: 16px 28px 20px 0; }
  .profile-content { position: sticky; top: 30px; }
  .profile-avatar { position: relative; width: 92px; height: 92px; margin: 0 0 20px 10px; border: 1px solid #c2b1f54d; border-radius: 50%; background: radial-gradient(ellipse at 75% 20%, #74539399, #243045b3 75%); }
  .profile-avatar :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
  .profile-initial { display: grid; place-items: center; width: 100%; height: 100%; color: #ebe1ff; font-size: 35px; font-weight: 600; }
  .profile-star { position: absolute; right: -5px; bottom: -2px; color: var(--accent); }
  .profile-identity h2 { font-size: 26px; font-weight: 600; letter-spacing: -.7px; overflow-wrap: anywhere; }
  .profile-names { display: flex; flex-wrap: wrap; align-items: baseline; gap: 5px 9px; }
  .profile-real-name { color: var(--muted); font-size: 12px; font-weight: 400; letter-spacing: .02em; }
  .profile-handle { margin-top: 2px; color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
  .profile-bio { margin-top: 18px; color: var(--text); font-size: 13px; line-height: 1.9; white-space: pre-line; }
  .profile-details { display: grid; grid-template-columns: max-content minmax(0, 1fr); align-items: baseline; gap: 10px; margin: 20px 0 0; line-height: 1.85; }
  .profile-details dt { color: var(--muted); font-size: 11px; font-weight: 400; }
  .profile-details dd { margin: 0; color: var(--text); font-size: 12px; font-weight: 500; white-space: pre-line; overflow-wrap: anywhere; }
  .profile-links { display: flex; flex-direction: column; gap: 15px; margin-top: 25px; padding-top: 24px; border-top: 1px solid var(--line-strong); }
  .profile-links a { display: inline-flex; align-items: center; gap: 12px; min-height: 28px; font-size: 13px; color: var(--muted); width: fit-content; }
  .profile-links a:hover { color: var(--accent); }
  :global([data-theme='light']) .profile-avatar { background: linear-gradient(135deg, #eee6ff, #e2e9f6); border-color: #7151ad33; }
  :global([data-theme='light']) .profile-initial { color: #574371; }
  @media (max-width: 900px) { .profile-card { padding-right: 20px; } .profile-bio { font-size: 12px; } }
  @media (max-width: 720px) {
    .profile-card { padding: 0 0 24px; border-right: 0; border-bottom: 1px solid var(--line-strong); }
    .profile-content { position: static; display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px 18px; align-items: center; }
    .profile-avatar { width: 64px; height: 64px; margin: 0; }
    .profile-initial { font-size: 27px; }
    .profile-identity h2 { font-size: 23px; }
    .profile-bio { grid-column: 1 / -1; margin: 0; }
    .profile-details { grid-column: 1 / -1; margin: 5px 0 0; }
    .profile-links { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; gap: 12px 24px; margin: 0; padding-top: 6px; border: 0; }
    .profile-links a { font-size: 12px; gap: 8px; }
  }
</style>
