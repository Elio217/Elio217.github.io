---
interface Props { kind: 'journal' | 'browser' | 'security' | 'pipeline' }
const { kind } = Astro.props;
---
<svg viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class:list={['portfolio-art', `art-${kind}`]}>
  {kind === 'journal' ? <>
    <ellipse cx="123" cy="100" rx="113" ry="26" transform="rotate(-14 123 100)" stroke="currentColor" stroke-width="1.6" />
    <g transform="translate(77 28) rotate(10 50 60)">
      <rect x="7" y="7" width="100" height="120" rx="9" fill="var(--art-fill)" stroke="currentColor" stroke-width="1.8" />
      <rect width="100" height="120" rx="9" fill="var(--glass, #101522)" stroke="currentColor" stroke-width="1.8" />
      <path d="m39 46-14 13 14 13m24-26 14 13-14 13m-9-32-7 38M97 36h18v14H97" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      {[17, 34, 51, 68, 85, 102].map((y) => <path d={`M5 ${y}c-18-10-18 13 0 8`} stroke="currentColor" stroke-width="1.7" />)}
    </g>
    <path d="m205 10 4 12 12 4-12 4-4 12-4-12-12-4 12-4 4-12Z" fill="var(--art-fill)" stroke="currentColor" stroke-width="1.6" />
    <circle cx="37" cy="53" r="3" stroke="currentColor" stroke-width="1.5" opacity=".45" />
  </> : kind === 'browser' ? <>
    <rect x="33" y="38" width="180" height="126" rx="10" fill="var(--art-fill)" opacity=".7" />
    <rect x="24" y="29" width="180" height="126" rx="10" fill="var(--glass, #101522)" stroke="currentColor" stroke-width="2" />
    <path d="M24 53h180" stroke="currentColor" stroke-width="2" />
    {[39, 51, 63].map((x) => <circle cx={x} cy="41" r="3" stroke="currentColor" stroke-width="1.5" />)}
    <rect x="41" y="72" width="69" height="63" rx="5" fill="var(--art-fill)" />
    <path d="m44 126 20-22 13 13 13-20 17 29H44Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    <circle cx="96" cy="84" r="4" stroke="currentColor" stroke-width="1.5" />
    <path d="M128 78h56m-56 19h49m-49 19h56m-56 18h32" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".7" />
  </> : kind === 'pipeline' ? <>
    <path d="M56 53h64v73h64" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <path d="m105 48 7 5-7 5m62 63 7 5-7 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="18" y="27" width="58" height="52" rx="10" fill="var(--glass, #101522)" stroke="currentColor" stroke-width="2" />
    <path d="m38 44-9 9 9 9m17-18 9 9-9 9m-8-22-5 28" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="91" y="66" width="58" height="52" rx="10" fill="var(--art-fill)" stroke="currentColor" stroke-width="2" />
    <path d="m120 77-15 6v11c0 10 15 17 15 17s15-7 15-17V83l-15-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    <path d="m113 93 5 5 9-11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="164" y="100" width="58" height="52" rx="10" fill="var(--glass, #101522)" stroke="currentColor" stroke-width="2" />
    <path d="M177 113h32v18h-32zM183 138h20m-10-7v7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="192" cy="160" r="3" fill="currentColor" opacity=".45" />
  </> : <>
    <rect x="18" y="35" width="132" height="95" rx="9" fill="var(--glass, #101522)" stroke="currentColor" stroke-width="2" />
    <path d="M18 55h132m-109 25 9 7-9 7m18 1h19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="93" y="90" width="126" height="77" rx="10" fill="var(--art-fill)" stroke="currentColor" stroke-width="2" />
    <path d="M144 91V73a15 15 0 0 1 30 0v18m-15 24-19 7v13c0 14 19 22 19 22s19-8 19-22v-13l-19-7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    <path d="m151 135 6 6 10-13M173 28l4-13m19 28 12-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </>}
</svg>
<style>.portfolio-art { display: block; width: 100%; height: auto; color: var(--art-highlight, var(--accent)); }</style>
