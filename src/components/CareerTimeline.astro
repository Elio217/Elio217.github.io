---
import { CAREER, CTF_RESULTS } from '../data/portfolio';

const formatCtfDate = (date: string) => date.replaceAll('-', '.');
---
<ol class="career-timeline">
  {CAREER.map(({ category, organization, detail, period, description, activities }) => (
    <li class="career-entry">
      <span class="career-marker" aria-hidden="true"></span>
      <div class="career-label"><span>{category}</span></div>
      <div class="career-content">
        <div class="career-heading">
          <h3>{organization}</h3>
          {period && <p class="career-period"><span aria-hidden="true">·</span> {period}</p>}
        </div>
        <p class="career-detail">{detail}</p>
        {activities && activities.length > 0 && (
          <ul class="career-activities" aria-label="동아리 활동">
            {activities.map((activity) => (
              <li>
                <span class="activity-name">{activity.name}</span>
                {activity.period && <span class="activity-period"> · {activity.period}</span>}
              </li>
            ))}
          </ul>
        )}
        {description && <p class="career-description">{description}</p>}
      </div>
    </li>
  ))}
  {CTF_RESULTS.length > 0 && (
    <li class="career-entry career-entry-ctf">
      <span class="career-marker" aria-hidden="true"></span>
      <div class="career-label"><h3 id="ctf-title" class="career-category">CTF</h3></div>
      <div class="career-content">
        <ul class="ctf-results" aria-labelledby="ctf-title">
          {CTF_RESULTS.map(({ name, placement, team, startDate, endDate }) => (
            <li class="ctf-result">
              <div class="ctf-result-copy">
                <p class="ctf-result-title">{name} - <span>{placement}</span></p>
                {team && <p class="ctf-team">{team}</p>}
              </div>
              <p class="ctf-period">
                <time datetime={startDate}>{formatCtfDate(startDate)}</time>
                {endDate && <> ~ <time datetime={endDate}>{formatCtfDate(endDate)}</time></>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </li>
  )}
</ol>
<style>
  .career-timeline { list-style: none; padding: 0 0 0 26px; margin: 32px 0 0 5px; border-left: 1px solid var(--line-strong); }
  .career-entry { position: relative; display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 30px; padding-bottom: 42px; }
  .career-entry:last-child { padding-bottom: 0; }
  .career-marker { position: absolute; left: -32px; top: 10px; width: 11px; height: 11px; background: var(--accent); border-radius: 50%; border: 2px solid var(--bg); box-shadow: 0 0 15px #ac86e644; }
  .career-label > span, .career-label > .career-category { display: inline-flex; padding: 3px 13px; border: 1px solid var(--line-strong); border-radius: 20px; color: var(--accent); background: var(--accent-bg); font-size: 11px; font-weight: 400; line-height: 1.7; letter-spacing: normal; }
  .career-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .career-period { color: var(--muted); font-size: 13px; }
  h3 { font-size: 21px; font-weight: 600; letter-spacing: -.6px; }
  .career-detail { font-size: 14px; color: var(--muted); margin-top: 7px; }
  .career-activities { display: grid; gap: 10px; margin: 18px 0 0; padding-left: 19px; list-style: disc; font-size: 14px; }
  .career-activities li { padding-left: 2px; }
  .career-activities li::marker { color: var(--muted); }
  .activity-name { color: var(--text); font-weight: 500; }
  .activity-period { color: var(--muted); font-size: 13px; }
  .career-description { font-size: 13px; color: var(--muted); line-height: 1.9; margin-top: 14px; }
  .ctf-results { list-style: none; margin: 0; padding: 0; }
  .ctf-result { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 6px 18px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .ctf-result:first-child { padding-top: 0; }
  .ctf-result:last-child { padding-bottom: 0; border-bottom: 0; }
  .ctf-result-copy { min-width: 0; }
  .ctf-result-title { min-width: 0; font-size: 15px; font-weight: 500; line-height: 1.8; }
  .ctf-result-title span { color: var(--accent); white-space: nowrap; }
  .ctf-team { margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 1.7; }
  .ctf-period { color: var(--muted); font-size: 12px; white-space: nowrap; }
  @media (max-width: 900px) { .ctf-result { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 600px) { .career-entry { grid-template-columns: 1fr; gap: 15px; padding-bottom: 34px; } h3 { font-size: 19px; } }
</style>
