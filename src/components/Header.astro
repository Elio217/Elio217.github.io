---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
const { overlay = false } = Astro.props;
const pathname = Astro.url.pathname;
const links = [{ href: '/', label: '홈' }, { href: '/projects/', label: '프로젝트' }, { href: '/blog/', label: '글 목록' }, { href: '/about/', label: '소개' }];
---
<header class:list={['site-header', { 'header-overlay': overlay }]}>
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="Elio 블로그 홈">
      <Icon name="star" size={27} /><span>Elio<span class="wordmark-dot">.</span></span>
    </a>
    <nav aria-label="메인 메뉴">
      {links.map(({ href, label }) => {
        const active = href === '/' ? pathname === '/' : pathname.startsWith(href);
        return <a href={href} class:list={{ active }} aria-current={active ? 'page' : undefined}>{label}</a>;
      })}
    </nav>
    <div class="header-actions">
      <a class="icon-button search-link" href="/blog/#search" aria-label="글 검색"><Icon name="search" size={19} /></a>
      <ThemeToggle />
    </div>
  </div>
</header>
