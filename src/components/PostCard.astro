---
import Icon from './Icon.astro';
import { formatDate, postUrl, readingTime, tagUrl, type Post } from '../lib/posts';
interface Props { post: Post; index?: number; compact?: boolean }
const { post, index, compact = false } = Astro.props;
const Heading = compact ? 'h2' : 'h3';
---
<article class:list={['post-card', { compact }]}>
  <div class="post-topline">
    <div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span class="meta-dot">·</span><span>{readingTime(post)}분 읽기</span></div>
    {index !== undefined && <span class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
  </div>
  <Heading class="post-title"><a href={postUrl(post)}>{post.data.title}<Icon name="external" size={20} /></a></Heading>
  <p class="post-description">{post.data.description}</p>
  <div class="post-tags">{post.data.tags.map((tag) => <a href={tagUrl(tag)} class="tag">{tag}</a>)}</div>
</article>
